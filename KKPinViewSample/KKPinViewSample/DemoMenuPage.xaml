<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KKPinViewSample.DemoMenuPage"
    Title="KKPinView Demo"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="KKPinView Demo"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,0,0,8" />
            <Label Text="Tap a button to open a popup. Each flow dismisses when complete. Ideal for demo videos."
                FontSize="14"
                TextColor="Gray"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,16" />

            <Button x:Name="BtnSetupPin"
                Text="Setup PIN"
                Clicked="OnSetupPinClicked"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="8"
                Padding="16,12" />
            <Label Text="Opens popup. Enter PIN, confirm, success → popup dismisses."
                FontSize="12" TextColor="Gray" Margin="0,-8,0,0" />

            <Button x:Name="BtnValidatePin"
                Text="Validate PIN"
                Clicked="OnValidatePinClicked"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="8"
                Padding="16,12" />
            <Label Text="Opens popup. Enter correct PIN → popup dismisses. Try wrong PIN for red border."
                FontSize="12" TextColor="Gray" Margin="0,-8,0,0" />

            <Button x:Name="BtnForgotPin"
                Text="Forgot PIN"
                Clicked="OnForgotPinClicked"
                BackgroundColor="#6c757d"
                TextColor="White"
                CornerRadius="8"
                Padding="16,12" />
            <Label Text="Opens popup. Reset PIN → popup dismisses. Create new PIN with Setup PIN."
                FontSize="12" TextColor="Gray" Margin="0,-8,0,0" />

            <BoxView HeightRequest="1" Color="#eee" Margin="0,16,0,8" />
            <Label Text="Features: Secure storage • Setup &amp; Confirm • Mismatch animation • Invalid PIN border • Lockout • Forgot PIN"
                FontSize="13"
                TextColor="Gray"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
