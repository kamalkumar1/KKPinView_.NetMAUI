<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<InternalsVisibleTo Include="KKPinView.Tests" />
		<InternalsVisibleTo Include="KKOTPView" />
	</ItemGroup>

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<SupportedOSPlatformVersion
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
			15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion
			Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
			21.0</SupportedOSPlatformVersion>

		<!-- NuGet Package Metadata -->
		<PackageId>KKPinView</PackageId>
		<Version>1.0.0</Version>
		<Authors>kamalkumar</Authors>
		<Company>KKPinView</Company>
		<Product>KKPinView</Product>
		<Description>A secure, enterprise-ready PIN entry and management library for .NET MAUI applications. Provides PIN setup, authentication, secure storage with AES-256 encryption, and lockout protection.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/kamalkumar1/KKPinView_.NetMAUI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kamalkumar1/KKPinView_.NetMAUI</RepositoryUrl>
		<PackageTags>maui;dotnet-maui;ios;android;mobile;mobile-app;pin;pin-setup;security;authentication;encryption;lockout;keypad;secure-storage;keychain;aes-256</PackageTags>
		<PackageReadmeFile>PackageREADME.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="PackageREADME.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>