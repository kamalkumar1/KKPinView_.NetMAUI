<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KKPinView.Views"
    x:Class="KKPinView.Views.PinDigitField"
    x:Name="Root">
    <Border
        x:Name="DigitBorder"
        StrokeThickness="2"
        Stroke="{Binding Source={x:Reference Root}, Path=BorderColor}"
        BackgroundColor="{Binding Source={x:Reference Root}, Path=BackgroundColor}"
        WidthRequest="{Binding Source={x:Reference Root}, Path=FieldWidth}"
        HeightRequest="{Binding Source={x:Reference Root}, Path=FieldHeight}"
        StrokeShape="{Binding Source={x:Reference Root}, Path=StrokeShape}">

        <!-- Grid: Entry receives keyboard when focused programmatically; overlay blocks hand taps so user cannot tap to focus/move cursor. -->
        <Grid>
            <views:BackspaceAwareEntry
                x:Name="DigitEntry"
                Text="{Binding Source={x:Reference Root}, Path=Digit}"
                Keyboard="Numeric"
                MaxLength="1"
                IsPassword="{Binding Source={x:Reference Root}, Path=IsSecure}"
                FontSize="{Binding Source={x:Reference Root}, Path=FontSize}"
                FontAttributes="{Binding Source={x:Reference Root}, Path=DigitFontAttributes}"
                TextColor="{Binding Source={x:Reference Root}, Path=TextColor}"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                TextChanged="OnDigitEntryTextChanged"
                Completed="OnDigitEntryCompleted" />
            <!-- Overlay captures touches so user cannot tap entry; keyboard input still works when entry is focused programmatically -->
            <BoxView x:Name="TouchBlocker" BackgroundColor="Transparent" InputTransparent="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=FocusEntryCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
        </Grid>
    </Border>
</ContentView>