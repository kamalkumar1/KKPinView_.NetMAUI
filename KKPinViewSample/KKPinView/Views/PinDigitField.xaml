<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KKPinView.Views"
    x:Class="KKPinView.Views.PinDigitField"
    x:Name="Root">
    <Border
        x:Name="DigitBorder"
        StrokeThickness="2"
        Stroke="{Binding Source={x:Reference Root}, Path=BorderColor}"
        BackgroundColor="{Binding Source={x:Reference Root}, Path=BackgroundColor}"
        WidthRequest="{Binding Source={x:Reference Root}, Path=FieldWidth}"
        HeightRequest="{Binding Source={x:Reference Root}, Path=FieldHeight}"
        StrokeShape="{Binding Source={x:Reference Root}, Path=StrokeShape}">

        <!-- BackspaceAwareEntry raises event when backspace pressed on empty field (iOS/Android) -->
        <views:BackspaceAwareEntry
            x:Name="DigitEntry"
            Text="{Binding Source={x:Reference Root}, Path=Digit}"
            Keyboard="Numeric"
            MaxLength="1"
            IsPassword="True"
            FontSize="{Binding Source={x:Reference Root}, Path=FontSize}"
            TextColor="{Binding Source={x:Reference Root}, Path=TextColor}"
            BackgroundColor="Transparent"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Center"
            TextChanged="OnDigitEntryTextChanged"
            Completed="OnDigitEntryCompleted" />
    </Border>
</ContentView>