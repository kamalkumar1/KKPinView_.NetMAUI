<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:KKPinView.Views"
             x:Class="KKPinView.Views.KKPinViews"
             x:Name="Root"
             BackgroundColor="{Binding BackgroundColor}">
    <ScrollView>
        <VerticalStackLayout
            Spacing="30"
            Padding="30,60,30,30"
            VerticalOptions="Center">
            
            <!-- Title -->
            <Label
                x:Name="TitleLabel"
                Text="{Binding TitleText}"
                FontSize="{Binding TitleFontSize}"
                TextColor="{Binding TextColor}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center" />
            
            <!-- Subtitle -->
            <Label
                x:Name="SubtitleLabel"
                Text="{Binding SubtitleText}"
                FontSize="{Binding SubtitleFontSize}"
                TextColor="{Binding TextColor}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Opacity="0.7" />
            
            <!-- PIN Fields -->
            <HorizontalStackLayout
                x:Name="PinFieldsContainer"
                Spacing="{Binding FieldSpacing}"
                HorizontalOptions="Center" />
            
            <!-- Error Message -->
            <Label
                x:Name="ErrorMessageLabel"
                Text="{Binding ErrorMessage}"
                FontSize="{Binding SubtitleFontSize}"
                TextColor="{Binding ErrorTextColor}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding HasError}" />
            
            <!-- Success Message -->
            <Label
                x:Name="SuccessMessageLabel"
                Text="{Binding SuccessMessage}"
                FontSize="{Binding SubtitleFontSize}"
                TextColor="{Binding SuccessTextColor}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                HeightRequest="0" />
            
            <!-- Numeric Keypad -->
            <views:NumericKeypad
                x:Name="Keypad"
                NumberCommand="{Binding NumberCommand}"
                DeleteCommand="{Binding DeleteCommand}"
                IsEnabled="{Binding IsKeypadEnabled}"
                Opacity="{Binding KeypadOpacity}" />
            
            <!-- Forgot PIN Button -->
            <Button
                x:Name="ForgotPinButton"
                Text="{Binding ForgotPinText}"
                TextColor="{Binding TextColor}"
                BackgroundColor="Transparent"
                Clicked="OnForgotPinClicked"
                IsVisible="{Binding ShowForgotPin}"
                Margin="0,20,0,0" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
