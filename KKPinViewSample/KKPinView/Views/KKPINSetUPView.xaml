<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KKPinView.Views.KKPINSetUPView"
    x:Name="Root"
    BackgroundColor="White">

    <ContentView.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnRootTapped" />
    </ContentView.GestureRecognizers>
    <ScrollView>
        <Grid
            RowDefinitions="Auto"
            RowSpacing="0">
            <VerticalStackLayout
                Grid.Row="0"
                Spacing="30"
                Padding="30,60,30,30"
                VerticalOptions="Start">

                <!-- Requirement 2: Label with name "Enter the PIN" -->
                <Label
                    x:Name="EnterPinLabel"
                    Text="{Binding EnterPinLabelText}"
                    FontSize="{Binding SubtitleFontSize}"
                    TextColor="{Binding TextColor}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <!-- Requirement 3: PIN digit text fields (number based on TotalPinTextFields constant,
            round/rectangle/corner radius from constants) -->
                <HorizontalStackLayout
                    x:Name="EnterPinFieldsContainer"
                    Spacing="{Binding FieldSpacing}"
                    HorizontalOptions="Center" />

                <!-- Requirement 4: Label with name "Confirm the PIN" -->
                <Label
                    x:Name="ConfirmPinLabel"
                    Text="{Binding ConfirmPinLabelText}"
                    FontSize="{Binding SubtitleFontSize}"
                    TextColor="{Binding TextColor}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding ShowConfirmPin}" />

                <!-- Requirement 5: Confirm PIN digit text fields (number based on TotalPinTextFields
                constant,
            round/rectangle/corner radius from constants) -->
                <HorizontalStackLayout
                    x:Name="ConfirmPinFieldsContainer"
                    Spacing="{Binding FieldSpacing}"
                    HorizontalOptions="Center"
                    IsVisible="{Binding ShowConfirmPin}" />

                <!-- Requirement 6: Error message label to display unmatched PIN -->
                <Label
                    x:Name="ErrorMessageLabel"
                    HeightRequest="0"
                    Text="{Binding ErrorMessage}"
                    FontSize="{Binding SubtitleFontSize}"
                    TextColor="{Binding ErrorTextColor}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />

                <!-- Requirement 6: Success message label -->
                <Label
                    x:Name="SuccessMessageLabel"
                    Text="{Binding SuccessMessage}"
                    FontSize="{Binding SubtitleFontSize}"
                    TextColor="{Binding SuccessTextColor}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    HeightRequest="0" />
            </VerticalStackLayout>

        </Grid>
    </ScrollView>

</ContentView>